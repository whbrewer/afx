#!/usr/bin/env bash
# Background helper spawned (detached) by afx-codex-sessionend: mirrors
# hooks/afx-summarize-async but asks Codex itself for the recap instead of
# `claude -p`, via `codex exec --ephemeral` (so this call never persists a
# rollout file or shows up in `afx list` on its own) with
# `--dangerously-bypass-hook-trust` (a detached background job can't answer
# an interactive hook-trust prompt) and `AFX_IN_HOOK=1` so it can't recurse
# into afx-codex-userpromptsubmit/-sessionend for its own throwaway turn.
# `-o <file>` writes just the agent's final message, with none of `codex
# exec`'s banner/token-count chatter to strip out.
#
# Unlike Claude's hook (which defaults AFX_SUMMARY_MODEL to "haiku", a
# stable cheap-tier alias every account has), there's no equivalent
# universal alias for `codex exec -m`, so -m is only passed when
# AFX_SUMMARY_MODEL is set -- otherwise this uses whatever model is already
# configured in the account's own config.toml.
#
# Any failure exits quietly; the heuristic summary already written by the
# hook stands.

sid="$1" sessions="$2" cwd="$3" home="$4" reason="$5"
excerpt="$(cat)"

tmp_out="$(mktemp)"
trap 'rm -f "$tmp_out"' EXIT

model_args=()
[ -n "${AFX_SUMMARY_MODEL:-}" ] && model_args=(-m "$AFX_SUMMARY_MODEL")

printf 'Session transcript:\n%s\n\nWrite a concise recap paragraph of this session. Describe what was done, the approach, and the outcome. Keep it to 2-4 sentences, specific and technical. Respond with only the paragraph, no preamble.\n' "$excerpt" \
  | AFX_IN_HOOK=1 timeout 45 codex exec --skip-git-repo-check --ephemeral \
      --sandbox read-only --dangerously-bypass-hook-trust \
      "${model_args[@]}" -o "$tmp_out" - >/dev/null 2>&1

detail="$(tr '\n' ' ' < "$tmp_out" 2>/dev/null | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | cut -c1-700)"

[ -n "$detail" ] || exit 0

# Patch the detail into the sessions file (preserve everything else).
lock_cmd=""
if command -v flock >/dev/null 2>&1; then
  lock_cmd="flock -w 5 200"
fi

update_detail () {
  old="$([ -f "$sessions" ] && jq -c --arg s "$sid" 'select(.session_id == $s)' "$sessions" | tail -1)"
  # If the row is gone, afx-codex-sessionend's synchronous write (which
  # always lands before this async job even starts) must have been removed
  # since -- almost certainly `afx rm`, run while this job was still
  # waiting on the LLM call. Respect that deletion instead of resurrecting
  # the row from scratch.
  [ -n "$old" ] || exit 0
  starred="$(jq -r '.starred // false' <<<"${old:-null}" 2>/dev/null)"
  name="$(jq -r '.name // empty' <<<"${old:-null}" 2>/dev/null)"
  note="$(jq -r '.note // empty' <<<"${old:-null}" 2>/dev/null)"
  tool="$(jq -r '.tool // "codex"' <<<"${old:-null}" 2>/dev/null)"
  prompts="$(jq -r '.prompts // 0' <<<"${old:-null}" 2>/dev/null)"
  date="$(jq -r '.date // empty' <<<"${old:-null}" 2>/dev/null)"
  date="${date:-$(date '+%F %H:%M')}"
  reason="$(jq -r '.reason // "exit"' <<<"${old:-null}" 2>/dev/null)"
  summary="$(jq -r '.summary // empty' <<<"${old:-null}" 2>/dev/null)"
  {
    [ -f "$sessions" ] && jq -c --arg s "$sid" 'select(.session_id != $s)' "$sessions"
    jq -nc --arg date "$date" --arg sid "$sid" --arg dir "$cwd" \
      --arg home "$home" --arg tool "$tool" --arg reason "$reason" --arg summary "$summary" \
      --arg detail "$detail" --argjson prompts "${prompts:-0}" \
      --argjson starred "${starred:-false}" --arg name "$name" --arg note "$note" \
      '{date: $date, session_id: $sid, dir: $dir, home: $home, tool: $tool,
        reason: $reason, summary: $summary,
        detail: (if $detail == "" then null else $detail end),
        prompts: $prompts,
        starred: $starred,
        name: (if $name == "" then null else $name end),
        note: (if $note == "" then null else $note end)}'
  } > "$sessions.tmp" && mv "$sessions.tmp" "$sessions"
}

if [ -n "$lock_cmd" ]; then
  ( $lock_cmd; update_detail ) 200>"$sessions.lock" 2>/dev/null
else
  update_detail
fi
